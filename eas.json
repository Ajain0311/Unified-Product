{
  "cli": {
    "version": ">= 12.0.0"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "env": {
        "EXPO_PUBLIC_ENV": "prod",
        "EXPO_PUBLIC_API_BASE_URL": "https://api.mmt.dev/api",
        "EXPO_PUBLIC_SIGNALR_HUB_URL": "https://api.mmt.dev",
        "EXPO_PUBLIC_SHOW_TEST_OTP": "false"
      }
    },
    "preview": {
      "distribution": "internal",
      "android": {
        "buildType": "apk"
      },
      "env": {
        "EXPO_PUBLIC_ENV": "prod",
        "EXPO_PUBLIC_API_BASE_URL": "https://api.mmt.dev/api",
        "EXPO_PUBLIC_SIGNALR_HUB_URL": "https://api.mmt.dev",
        "EXPO_PUBLIC_SHOW_TEST_OTP": "false"
      }
    },
    "production": {
      "android": {
        "buildType": "app-bundle"
      },
      "env": {
        "EXPO_PUBLIC_ENV": "prod",
        "EXPO_PUBLIC_API_BASE_URL": "https://api.mmt.dev/api",
        "EXPO_PUBLIC_SIGNALR_HUB_URL": "https://api.mmt.dev",
        "EXPO_PUBLIC_SHOW_TEST_OTP": "false"
      }
    }
  },
  "submit": {
    "production": {}
  }
}
