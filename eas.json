{
  "cli": {
    "version": ">= 12.0.0"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "env": {
        "EXPO_PUBLIC_ENV": "prod",
        "EXPO_PUBLIC_API_BASE_URL": "https://zupify-api.onrender.com/api",
        "EXPO_PUBLIC_SIGNALR_HUB_URL": "https://zupify-api.onrender.com",
        "EXPO_PUBLIC_SHOW_TEST_OTP": "false"
      },
      "channel": "development"
    },
    "preview": {
      "distribution": "internal",
      "android": {
        "buildType": "apk"
      },
      "env": {
        "EXPO_PUBLIC_ENV": "prod",
        "EXPO_PUBLIC_API_BASE_URL": "https://zupify-api.onrender.com/api",
        "EXPO_PUBLIC_SIGNALR_HUB_URL": "https://zupify-api.onrender.com",
        "EXPO_PUBLIC_SHOW_TEST_OTP": "false"
      },
      "channel": "preview"
    },
    "production": {
      "android": {
        "buildType": "app-bundle"
      },
      "env": {
        "EXPO_PUBLIC_ENV": "prod",
        "EXPO_PUBLIC_API_BASE_URL": "https://zupify-api.onrender.com/api",
        "EXPO_PUBLIC_SIGNALR_HUB_URL": "https://zupify-api.onrender.com",
        "EXPO_PUBLIC_SHOW_TEST_OTP": "false"
      },
      "channel": "production"
    }
  },
  "submit": {
    "production": {
      "android": {
        "serviceAccountKeyPath": "./pc-api-key.json",
        "track": "alpha"
      }
    }
  }
}
