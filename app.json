{
  "expo": {
    "name": "Zupify",
    "slug": "HTTP-EXPNAT-NET",
    "version": "1.0.6",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.zupify.app",
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "Zupify uses your location to set pickup points for rides and recommend nearby restaurants and stores.",
        "LSApplicationQueriesSchemes": [
          "tel",
          "telprompt"
        ]
      }
    },
    "android": {
      "package": "com.zupify.app",
      "versionCode": 6,
      "softwareKeyboardLayoutMode": "pan",
      "adaptiveIcon": {
        "backgroundColor": "#FFFFFF",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "CAMERA",
        "ACCESS_FINE_LOCATION",
        "ACCESS_COARSE_LOCATION",
        "POST_NOTIFICATIONS"
      ],
      "googleServicesFile": "./google-services.json"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-secure-store",
      "expo-font",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Zupify uses your location to set pickup points for rides and recommend nearby restaurants and stores."
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/icon.png",
          "color": "#1976D2"
        }
      ],
      "expo-dev-client",
      "@rnmapbox/maps",
      [
        "expo-build-properties",
        {
          "android": {
            "enableProguardInReleaseBuilds": true,
            "enableShrinkResourcesInReleaseBuilds": true
          }
        }
      ]
    ],
    "updates": {
      "url": "https://u.expo.dev/d34cada7-3333-4648-a237-b1b67069f607"
    },
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "extra": {
      "eas": {
        "projectId": "d34cada7-3333-4648-a237-b1b67069f607"
      }
    },
    "owner": "ajain0311"
  }
}
