{
  "expo": {
    "name": "RJ09 Sewa",
    "slug": "Unified-Product",
    "version": "1.0.7",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#FFFFFF"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.zupify.app",
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "RJ09 Sewa uses your location to set pickup points for rides and recommend nearby restaurants and stores.",
        "LSApplicationQueriesSchemes": [
          "tel",
          "telprompt"
        ]
      }
    },
    "android": {
      "package": "com.zupify.app",
      "versionCode": 11,
      "softwareKeyboardLayoutMode": "pan",
      "adaptiveIcon": {
        "backgroundColor": "#FFFFFF",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "CAMERA",
        "ACCESS_FINE_LOCATION",
        "ACCESS_COARSE_LOCATION",
        "POST_NOTIFICATIONS"
      ],
      "googleServicesFile": "./google-services.json"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#FFFFFF",
          "image": "./assets/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain"
        }
      ],
      "expo-secure-store",
      "expo-font",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Zupify uses your location to set pickup points for rides and recommend nearby restaurants and stores."
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/icon.png",
          "color": "#1976D2"
        }
      ],
      "expo-dev-client",
      "@rnmapbox/maps",
      "./plugins/withAndroidNdkVersion",
      [
        "expo-build-properties",
        {
          "android": {
            "ndkVersion": "27.0.12077973",
            "enableProguardInReleaseBuilds": true,
            "enableShrinkResourcesInReleaseBuilds": true
          }
        }
      ]
    ],
    "updates": {
      "url": "https://u.expo.dev/588c4dc6-4d8c-41dc-b8e6-cbcd8794fcb4"
    },
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "extra": {
      "eas": {
        "projectId": "588c4dc6-4d8c-41dc-b8e6-cbcd8794fcb4"
      }
    },
    "owner": "ajain0311"
  }
}
